{
  "name": "notcord",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws/*", "/files/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "notcord", "database_id": "becd0360-20c6-4de0-bb37-7f7be3bc1f43" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ]
}
